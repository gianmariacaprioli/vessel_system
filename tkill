#!/usr/bin/env bash

set -u

SESSION="${1:-}"

if [[ -z "$SESSION" ]]; then
    if [[ -z "${TMUX:-}" ]]; then
        echo "ERROR: tkill must be run from inside the tmux simulation session."
        exit 1
    fi

    SESSION="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')"
fi

TARGET=
while IFS=' ' read -r id name; do
    if [[ "$SESSION" == "$id" || "$SESSION" == "$name" ]]; then
        TARGET="$id"
        break
    fi
done < <(tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null)
if [[ -z "$TARGET" ]]; then
    echo "Sessione tmux '$SESSION' non trovata." >&2
    exit 1
fi

if [[ -n "${TMUX:-}" && "${TKILL_DETACHED:-0}" != "1" ]]; then
    # The shutdown worker must live outside tmux; otherwise it would terminate
    # itself while closing the pane from which tkill was invoked.
    LOG_FILE="$(mktemp /tmp/asv_shutdown.XXXXXX)" || exit 1
    TKILL_DETACHED=1 nohup setsid -f "$0" "$TARGET" \
        >"$LOG_FILE" 2>&1 </dev/null &

    echo "Stopping tmux session '$SESSION'..."
    echo "Shutdown log: $LOG_FILE"
    exit 0
fi

RUN_ID="$(tmux show-options -qv -t "$TARGET" @asv_sim_run_id)"

# Ask every foreground process to stop cleanly. This lets ros2 launch forward
# SIGINT to Gazebo, RViz, bridges and the remaining ROS nodes.
while IFS= read -r pane; do
    tmux send-keys -t "$pane" C-c 2>/dev/null || true
done < <(tmux list-panes -s -t "$TARGET" -F '#{pane_id}')

if [[ -z "$RUN_ID" ]]; then
    sleep 5
    tmux kill-session -t "$TARGET" 2>/dev/null || true
    echo "Sessione senza identificatore: eventuali processi staccati non sono verificabili." >&2
    exit 0
fi

# Match an exact inherited environment entry, independently of process names.
# The control pane's interactive shell exports the token after startup, so its
# initial /proc environment remains untagged. Exclude the shutdown worker too.
is_run_process() {
    [[ "$1" != "$$" && -O "/proc/$1" ]] &&
        grep -zFxq "ASV_SIM_RUN_ID=$RUN_ID" "/proc/$1/environ" 2>/dev/null
}

collect_run_processes() {
    local entry pid
    RUN_PIDS=()
    while IFS= read -r entry; do
        pid="${entry#/proc/}"
        pid="${pid%/environ}"
        if [[ "$pid" != "$$" && -O "/proc/$pid" ]]; then
            RUN_PIDS+=("$pid")
        fi
    done < <(grep -zlFx "ASV_SIM_RUN_ID=$RUN_ID" /proc/[0-9]*/environ 2>/dev/null)
}

wait_for_run() {
    local attempt
    for ((attempt=0; attempt<$1; attempt++)); do
        collect_run_processes
        ((${#RUN_PIDS[@]} == 0)) && return 0
        sleep 0.5
    done
    return 1
}

signal_run() {
    local pid
    collect_run_processes
    for pid in "${RUN_PIDS[@]}"; do
        if is_run_process "$pid"; then kill "-$1" "$pid" 2>/dev/null || true; fi
    done
}

if ! wait_for_run 12; then
    signal_run TERM
    if ! wait_for_run 6; then signal_run KILL; fi
fi
tmux kill-session -t "$TARGET" 2>/dev/null || true
if ! wait_for_run 4; then
    echo "Processi della simulazione ancora attivi: ${RUN_PIDS[*]}" >&2
    exit 1
fi
echo "Simulazione arrestata."

